    "happy-dom": "^21.0.4",
    "obsidian": "^1.14.4",
    "obsidian-typings": "^6.51.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@zumer/snapdom": "^3.4.0",
    "immer": "^11.2.9",
    "jspdf": "^4.2.1",
    "monkey-around": "^3.0.0",
    "svg2pdf.js": "^2.8.1",
    "utif": "^3.1.0"
