  "description": "Page-based figure and slide editor where every panel is a live link to its source.",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "test": "vitest run",
    "deploy": "node scripts/deploy.mjs",
    "typecheck": "tsc --noEmit"
  },
  "author": "Kenta Ninomiya",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "builtin-modules": "^5.4.0",
